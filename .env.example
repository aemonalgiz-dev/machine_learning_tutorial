# For a local checkout, copy this file to .env.development.local.
# Configure production URLs through the hosting environment instead.

# The base URL of the oop_ml compute API this site fits against.
# Defaults to the local FastAPI dev server when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional override for the site's Patreon support link.
NEXT_PUBLIC_PATREON_URL=https://www.patreon.com/JeffreyGordon

# Server-only URL of ../backend, the separate account and saved-work service.
# This is not the compute API above. Do not use a NEXT_PUBLIC_ prefix.
# Local: put this setting in .env.development.local, run the configured
# backend on port 8001, then restart Next.js. .env.local also loads in production.
# Production: set this to the deployed HTTPS backend URL in Amplify.
# amplify.yml copies only this URL into .env.production for the server runtime.
# Leave unset or empty to keep guest learning available without accounts.
# OIDC credentials, the database URL and session secret belong only in backend.
OOP_ML_ACCOUNTS_URL=http://127.0.0.1:8001
