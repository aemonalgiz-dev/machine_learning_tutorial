{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "curriculum:generate": "node scripts/build-curriculum.mjs",
    "curriculum:check": "node scripts/build-curriculum.mjs --check",
    "prepare:python": "node scripts/prepare-python.mjs",
    "test:practice": "node scripts/check-practice.mjs",
    "test:lesson-examples": "node scripts/check-lesson-examples.mjs",
    "record:practice": "node scripts/check-practice.mjs --record",
    "prerecord:practice": "npm run prepare:python",
    "pretest:practice": "npm run prepare:python -- --verify",
    "test:runner": "python scripts/test_runner.py",
    "test:sql": "node --test scripts/test-sql-runtime.mjs",
    "test:browser": "playwright test",
    "test:backend": "playwright test --config playwright.backend.config.ts",
    "check:backend": "node scripts/check-account-backend.mjs",
    "predev": "npm run prepare:python",
    "prebuild": "npm run curriculum:check && npm run prepare:python -- --verify",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/finalize-native-image-trace.mjs && node scripts/report-build-size.mjs --max-mib=200",
    "size:build": "node scripts/report-build-size.mjs",
    "check:images": "node scripts/native-image-runtime.mjs",
    "test:deployment": "node --test scripts/native-image-runtime.test.mjs scripts/report-build-size.test.mjs",
    "test:production": "playwright test --config playwright.production.config.ts",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "fflate": "0.8.2",
    "pyodide": "314.0.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
